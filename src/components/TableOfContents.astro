---
import type { MarkdownHeading } from "astro";

interface Props {
    headings: MarkdownHeading[];
}

const { headings } = Astro.props;
const toc = headings.filter(
    (heading) => heading.depth === 2 || heading.depth === 3,
);
---

{toc.length > 0 && (
    <>
        <div class="xl:hidden">
            <button
                type="button"
                popovertarget="toc-popover"
                class="toc-fab touch-target cursor-pointer text-sm text-zinc-300"
            >
                <span aria-hidden="true" class="mr-2">
                    ☰
                </span>
                <span class="toc-fab-label">Contents</span>
            </button>
            <nav
                popover
                id="toc-popover"
                aria-label="Table of contents"
                class="toc-popover"
            >
                <p class="mb-3 text-xs font-semibold tracking-widest text-zinc-500 uppercase">
                    On this page
                </p>
                <ul class="space-y-1 text-sm">
                    {toc.map((heading) => (
                        <li class={heading.depth === 3 ? "pl-4" : undefined}>
                            <a
                                href={`#${heading.slug}`}
                                class="toc-popover-link touch-target py-1"
                            >
                                {heading.text}
                            </a>
                        </li>
                    ))}
                </ul>
            </nav>
        </div>
        <nav aria-label="Table of contents" class="toc-desktop hidden xl:block">
            <p class="mb-3 text-xs font-semibold tracking-widest text-zinc-500 uppercase">
                On this page
            </p>
            <ul class="border-l border-zinc-700 text-sm">
                {toc.map((heading) => (
                    <li>
                        <a
                            href={`#${heading.slug}`}
                            class:list={[
                                "toc-link",
                                heading.depth === 3 && "toc-link-nested",
                            ]}
                        >
                            {heading.text}
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    </>
)}

<style>
    .toc-fab {
        position: fixed;
        right: 1rem;
        bottom: calc(1rem + env(safe-area-inset-bottom));
        z-index: 40;
        border: 1px solid var(--color-zinc-700);
        border-radius: 9999px;
        background: color-mix(in srgb, var(--color-zinc-850) 90%, transparent);
        backdrop-filter: blur(8px);
        padding: 0.6rem 1.1rem;
        transition: color 200ms ease-out;
    }

    .toc-fab:is(:hover, :focus-visible) {
        color: var(--color-rose-400);
    }

    .toc-fab-label {
        display: inline-block;
        max-width: min(14rem, 45vw);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        vertical-align: bottom;
    }

    .toc-popover-link {
        color: var(--color-zinc-400);
        transition: color 200ms ease-out;
    }

    .toc-popover-link:is(:hover, :focus-visible) {
        color: var(--color-rose-400);
    }

    .toc-popover-link[aria-current="true"] {
        color: var(--color-rose-400);
    }

    .toc-popover {
        position: fixed;
        inset: auto;
        right: 1rem;
        bottom: calc(4.25rem + env(safe-area-inset-bottom));
        margin: 0;
        width: min(20rem, calc(100vw - 2rem));
        max-height: min(24rem, calc(100vh - 8rem));
        overflow-y: auto;
        overscroll-behavior: contain;
        border: 1px solid var(--color-zinc-700);
        border-radius: 0.375rem;
        background: var(--color-zinc-850);
        padding: 1rem;
        color: var(--color-zinc-300);
    }

    .toc-popover::backdrop {
        background: rgb(0 0 0 / 0.35);
    }

    /* The page column is max-w-3xl (48rem) centered, so half is 24rem.
       Pin the desktop TOC in the free space to the right of it. */
    .toc-desktop {
        position: fixed;
        top: 6rem;
        left: calc(50% + 25rem);
        width: calc(50vw - 25rem - 1.5rem);
        max-width: 17rem;
        max-height: calc(100vh - 8rem);
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .toc-link {
        display: block;
        margin-left: -1px;
        border-left: 2px solid transparent;
        padding: 0.3rem 0 0.3rem 1rem;
        color: var(--color-zinc-400);
        line-height: 1.5;
        transition:
            color 200ms ease-out,
            border-color 200ms ease-out;
    }

    .toc-link-nested {
        padding-left: 2rem;
        font-size: 0.8rem;
    }

    .toc-link:is(:hover, :focus-visible) {
        color: var(--color-rose-400);
    }

    .toc-link[aria-current="true"] {
        border-left-color: var(--color-rose-400);
        color: var(--color-zinc-100);
    }
</style>

<script>
    const popover = document.getElementById("toc-popover");
    const fabLabel = document.querySelector<HTMLElement>(".toc-fab-label");

    // Close the mobile popover after a section is picked.
    popover?.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
            popover.hidePopover();
        }
    });

    // Scroll spy shared by the desktop sidebar and the mobile popover.
    const linksById = new Map<string, HTMLAnchorElement[]>();
    for (const link of document.querySelectorAll<HTMLAnchorElement>(
        ".toc-desktop .toc-link, .toc-popover a",
    )) {
        const id = decodeURIComponent(new URL(link.href).hash.slice(1));
        const group = linksById.get(id) ?? [];
        group.push(link);
        linksById.set(id, group);
    }
    const headings = Array.from(
        document.querySelectorAll<HTMLElement>(".blog-content :is(h2, h3)[id]"),
    ).filter((heading) => linksById.has(heading.id));

    if (headings.length > 0) {
        let activeId: string | null = null;

        function update() {
            let currentId: string | null = null;
            for (const heading of headings) {
                if (heading.getBoundingClientRect().top <= 100)
                    currentId = heading.id;
                else break;
            }
            if (currentId === activeId) return;
            for (const link of linksById.get(activeId ?? "") ?? []) {
                link.removeAttribute("aria-current");
            }
            for (const link of linksById.get(currentId ?? "") ?? []) {
                link.setAttribute("aria-current", "true");
                link.scrollIntoView({ block: "nearest" });
            }
            if (fabLabel) {
                fabLabel.textContent = currentId
                    ? (linksById.get(currentId)?.[0]?.textContent?.trim() ??
                      "Contents")
                    : "Contents";
            }
            activeId = currentId;
        }

        // Reveal the current section when the popover opens.
        popover?.addEventListener("toggle", () => {
            if (!popover.matches(":popover-open") || !activeId) return;
            linksById
                .get(activeId)
                ?.find((link) => link.closest(".toc-popover"))
                ?.scrollIntoView({ block: "center" });
        });

        let scheduled = false;
        function onScroll() {
            if (scheduled) return;
            scheduled = true;
            requestAnimationFrame(() => {
                scheduled = false;
                update();
            });
        }

        addEventListener("scroll", onScroll, { passive: true });
        addEventListener("resize", onScroll, { passive: true });
        update();
    }
</script>
