---
import BlogList from "../components/BlogList.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getBlogPosts } from "../lib/blog";

const posts = await getBlogPosts();

const projects = [
    {
        label: "Hyena Dart",
        href: "https://hyenadart.onlychan.xyz",
        description: "A Flutter and Dart analyzer for dead code and code complexity.",
    },
    {
        label: "Iris",
        href: "https://github.com/Chandram-Dutta/Iris",
        description: "A minimal 2D game engine in Swift.",
    },
    {
        label: "Flutter Icon Browser",
        href: "https://github.com/Chandram-Dutta/flutter_icon_browser",
        description: "Search icons across five libraries in one place.",
    },
    {
        label: "Step",
        href: "https://github.com/Chandram-Dutta/step",
        description: "My 2024 Swift Student Challenge winning submission.",
    },
];

const publications = [
    {
        title: "CAN-DAQ: An open-source, cost-effective data capture device and software for automotive research",
        href: "https://www.sciencedirect.com/science/article/pii/S2468067226000039",
        venue: "HardwareX · Elsevier",
        year: "2026",
    },
    {
        title: "Device to Measure Respiratory Rate in Children, in Resource Poor Settings",
        href: "https://link.springer.com/article/10.1007/s11220-024-00499-w",
        venue: "Sensing and Imaging · Springer",
        year: "2024",
    },
    {
        title: "Programmable Wireless Adapter for Commercial Electric Drives and Multifunction Meters",
        href: "https://ieeexplore.ieee.org/abstract/document/10434850",
        venue: "Innovations in Power and Advanced Computing Technologies (i-PACT) · IEEE",
        year: "2023",
    },
];

const documentLinks = [
    {
        label: "Resume",
        href: "https://links.onlychan.xyz/resume",
        external: true,
    },
    { label: "CV", href: "https://links.onlychan.xyz/cv", external: true },
];

const contactLinks = [
    { label: "Mail", href: "mailto:chandramdutta2004@gmail.com" },
    { label: "X", href: "https://links.onlychan.xyz/x", external: true },
    {
        label: "GitHub",
        href: "https://links.onlychan.xyz/github",
        external: true,
    },
    {
        label: "LinkedIn",
        href: "https://links.onlychan.xyz/linkedin",
        external: true,
    },
    {
        label: "Instagram",
        href: "https://links.onlychan.xyz/instagram",
        external: true,
    },
    {
        label: "Google Scholar",
        href: "https://links.onlychan.xyz/gscholar",
        external: true,
    },
];
---

<SiteLayout>
        <h1 class="text-2xl mb-8">Chandram Dutta</h1>
        <p class="mb-8">
            Software Engineer at{" "}
            <a
                href="https://adora-app.com/"
                target="_blank"
                class="touch-target text-zinc-300 underline decoration-emerald-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-emerald-400"
            >
                Adora
            </a>
            . 2x Apple{" "}
            <a
                href="https://developer.apple.com/swift-student-challenge/"
                target="_blank"
                class="touch-target text-zinc-300 underline decoration-orange-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-orange-400"
            >
                Swift Student Challenge Winner
            </a>
            . Graduated from{" "}
            <a
                href="https://vit.ac.in/"
                target="_blank"
                class="touch-target text-zinc-300 underline decoration-blue-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-blue-400"
            >
                VIT Vellore
            </a>{" "}
            majoring in Electrical and Electronics Engineering.
        </p>
        <nav aria-label="Contact and social links">
            {contactLinks.map((link, index) => (
                <>
                    <a
                        href={link.href}
                        class="touch-target touch-target-wide text-zinc-300 underline decoration-fuchsia-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-fuchsia-400"
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                    >
                        {link.label}
                    </a>
                    {index < contactLinks.length - 1 && (
                        <span aria-hidden="true"> • </span>
                    )}
                </>
            ))}
        </nav>
        <nav aria-label="Documents" class="mt-4">
            {documentLinks.map((link, index) => (
                <>
                    <a
                        href={link.href}
                        class="touch-target touch-target-wide text-zinc-300 underline decoration-cyan-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-cyan-400"
                        target={link.external ? "_blank" : undefined}
                        rel={link.external ? "noopener noreferrer" : undefined}
                    >
                        {link.label}
                    </a>
                    {index < documentLinks.length - 1 && (
                        <span aria-hidden="true"> • </span>
                    )}
                </>
            ))}
        </nav>
        <nav aria-label="Projects" class="mt-8">
            <h2 class="mb-4">I have made some cool side projects over the years:</h2>
            <ul class="space-y-3">
                {projects.map((project) => (
                    <li>
                        <a
                            href={project.href}
                            class="touch-target text-zinc-300 underline decoration-amber-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-amber-400 focus-visible:text-amber-400"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {project.label}
                        </a>
                        <p class="text-sm text-zinc-400">{project.description}</p>
                    </li>
                ))}
            </ul>
            <a
                href="https://github.com/Chandram-Dutta?tab=repositories"
                class="touch-target mt-4 text-zinc-300 underline decoration-amber-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-amber-400 focus-visible:text-amber-400"
                target="_blank"
                rel="noopener noreferrer"
            >
                More on GitHub →
            </a>
        </nav>
        <section id="blog" aria-labelledby="blog-heading" class="mt-8">
            <h2 id="blog-heading" class="mb-4">Blog</h2>
            <BlogList posts={posts.slice(0, 3)} />
            <a href="/blog/" class="blog-link touch-target mt-4">
                All posts →
            </a>
        </section>
        <section id="research" aria-labelledby="research-heading" class="mt-8">
            <h2 id="research-heading" class="mb-4">Research</h2>
            <ul class="space-y-4">
                {publications.map((publication) => (
                    <li>
                        <a
                            href={publication.href}
                            class="touch-target text-zinc-300 underline decoration-violet-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-violet-400 focus-visible:text-violet-400"
                            target="_blank"
                            rel="noopener noreferrer"
                        >
                            {publication.title}
                        </a>
                        <p class="text-sm text-zinc-400">
                            {publication.venue} · <time datetime={publication.year}>{publication.year}</time>
                        </p>
                    </li>
                ))}
            </ul>
            <a
                href="https://links.onlychan.xyz/gscholar"
                class="touch-target mt-4 text-zinc-300 underline decoration-violet-400 underline-offset-4 transition-colors duration-200 ease-out hover:text-violet-400 focus-visible:text-violet-400"
                target="_blank"
                rel="noopener noreferrer"
            >
                Google Scholar →
            </a>
        </section>
</SiteLayout>
